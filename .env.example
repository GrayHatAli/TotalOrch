# Platform runtime
ORCHESTRATOR_ENV=development
ORCHESTRATOR_LOG_LEVEL=INFO

# OmniRoute is managed by the platform in the default deployment.
# For an external deployment, point this at the existing OmniRoute service.
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=
OMNIROUTE_MANAGEMENT_KEY=
OMNIROUTE_TIMEOUT_SECONDS=120
OMNIROUTE_MAX_RETRIES=2

# Used by deployment/docker-compose.yml. Pin this in real environments.
OMNIROUTE_IMAGE=omniroute:local
