[TEMPLATE]
# Platform runtime
ORCHESTRATOR_ENV=development
ORCHESTRATOR_LOG_LEVEL=INFO

# TotalOrch public API. Set a strong random value outside development.
TOTAL_ORCH_API_KEY=
TOTAL_ORCH_HOST=127.0.0.1
TOTAL_ORCH_PORT=8080

# Gateway selection. "omniroute" is the default managed gateway; any
# OpenAI-compatible router (litellm, 9router, oneapi, newapi, freellmapi, ...)
# is supported through the generic adapter.
GATEWAY_TYPE=omniroute
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_TIMEOUT_SECONDS=120
GATEWAY_MAX_RETRIES=2

# OmniRoute is managed by the platform in the default deployment.
# For an external deployment, point this at the existing OmniRoute service.
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=
OMNIROUTE_MANAGEMENT_KEY=
OMNIROUTE_TIMEOUT_SECONDS=120
OMNIROUTE_MAX_RETRIES=2

# Registry, workflow, and safety limits.
ORCHESTRATOR_REGISTRY_DATABASE_PATH=registry.db
ORCHESTRATOR_REGISTRY_STALE_AFTER_SECONDS=604800
ORCHESTRATOR_WORKSPACE_ROOT=
ORCHESTRATOR_WORKFLOW_MAX_CORRECTIONS=1
ORCHESTRATOR_WORKFLOW_NODE_TIMEOUT_SECONDS=120
ORCHESTRATOR_WORKFLOW_MAX_ATTEMPTS=2
# Off by default: review approval alone never writes a model-produced patch.
ORCHESTRATOR_WORKFLOW_APPLY_CHANGES=false
ORCHESTRATOR_REQUEST_MAX_BODY_BYTES=1048576
ORCHESTRATOR_RATE_LIMIT_PER_MINUTE=120

# Used by deployment/docker-compose.yml. Pin this in real environments.
OMNIROUTE_IMAGE=omniroute:local
